# ---- go (src/20-go.sh) ----
# gofmt on changed .go files, blocking only NEW violations (a file that was
# gofmt-clean at the base and is not at the pushed commit, or a new file that
# is not formatted); files already unformatted at the base are reported only.
# Module graph offline when go.mod/go.sum change.
# Tier 1 (fail closed): go build (non-main) + go vet on the changed packages.
# Tier 2 (best effort): go vet on their direct importers when the build cache
# makes it cheap and the budget allows.
# -trimpath keys the build cache independently of the checkout path, so every
# worktree and export shares one cache. When the cache is cold for this tree
# (more than PREPUSH_MAX_STALE packages to compile) the hook fails open and
# starts one detached, flock-guarded, nice 19 warm of this tree's packages and
# of <remote>/main, so the next push is warm.
GO_EXCLUDE=${GO_EXCLUDE:-'^(third_party|vendor)/|(^|/)testdata/'}
go_env() {
  have go || infra "go is not on PATH"
  export GOPROXY=off GOTOOLCHAIN=local GOMAXPROCS=${PREPUSH_GOMAXPROCS:-4}
  [ -n "${_goflags:-}" ] || { export GOFLAGS="${GOFLAGS:-} -mod=readonly -buildvcs=false -trimpath -p=${PREPUSH_GOP:-2}"; _goflags=1; }
}
gocheck() { # label, go args: fail closed on findings, open on uncached modules
  local label=$1 out rc; shift; go_env
  out=$(go "$@" 2>&1); rc=$?
  case $out in *"module lookup disabled"*) infra "a module is not in the local cache: run go mod download" ;; esac
  [ $rc -eq 0 ] || fail "$label:\n$out"
}
# stale <pkgs>: how many packages go build + go vet would compile for them:
# the packages, their deps, and the deps of their test files' imports, from
# one go list over the module ($pkgs). Not go list -test: that also counts the
# test main and its std deps (go/ast, internal/fuzz, ...), which vet never
# builds. Test-only imports outside the module's dep graph are not counted.
stale() {
  printf '%s\n' "$pkgs" | awk -F'|' -v want="$*" '
    function mark(p,   a, k, i) { if (p in M) return; M[p] = 1; k = split(dep[p], a, " "); for (i = 1; i <= k; i++) M[a[i]] = 1 }
    BEGIN { n = split(want, w, " "); for (i = 1; i <= n; i++) S[w[i]] = 1 }
    { st[$1] = ($3 == "true" && $2 != "main"); dep[$1] = $4; imp[$1] = $5 }
    END { for (s in S) { mark(s); k = split(imp[s], t, " "); for (j = 1; j <= k; j++) mark(t[j]) }
          c = 0; for (p in M) c += st[p]; print c }'
}

# gofmt_new: set fmt_bad to the gofmt output for the changed .go files that
# are newly unformatted (or newly unparseable), and fmt_old to the number of
# changed files that were already unformatted at $base (reported, not blocked).
fmt_bad="" fmt_old=0
gofmt_new() {
  local out cand f b
  fmt_bad="" fmt_old=0
  out=$(gofmt -l $gofiles 2>&1)
  [ -n "$out" ] || return 0
  cand=$(awk 'NR == FNR { want[$0] = 1; next }
    { if ($0 in want) print $0; else { p = $0; sub(/:[0-9]+:[0-9]+: .*$/, "", p); if (p in want) print p } }' \
    <(printf '%s\n' $gofiles) <(printf '%s\n' "$out") | sort -u)
  for f in $cand; do
    if git -C "$root" cat-file -e "$base:$f" 2>/dev/null; then
      b=$(git -C "$root" show "$base:$f" 2>/dev/null | gofmt -l 2>&1)
      if [ -n "$b" ]; then fmt_old=$((fmt_old + 1)); continue; fi
    fi
    fmt_bad="$fmt_bad$(printf '%s\n' "$out" | awk -v f="$f" '$0 == f || index($0, f ":") == 1')
"
  done
}

WARM_SH='
set -u
gd=$1 dir=$2 head=$3 main=$4 lock=$5 lib=$6 vet=$7 logdir=$8 key=$9
cd "$dir" || exit 0
ts() { date -u +%FT%TZ; }
