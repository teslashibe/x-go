# One job per pushed commit. Base: the merge-base with <remote>/main (the PR
# diff), or the old tip when pushing main itself. Deletions and tags skip.
jobs=""
while read -r lref lsha rref rsha; do
  [ -n "${lsha:-}" ] || continue
  [ "$lsha" = "$Z" ] && continue
  case $rref in refs/tags/*) continue ;; esac
  base=""
  if [ "$rref" = refs/heads/main ] && [ "$rsha" != "$Z" ] && git cat-file -e "$rsha^{commit}" 2>/dev/null; then
    base=$rsha
  else
    for m in "refs/remotes/$remote/main" refs/remotes/origin/main; do
      base=$(git merge-base "$lsha" "$m" 2>/dev/null) && break
    done
    if [ -z "$base" ] && [ "$rsha" != "$Z" ] && git cat-file -e "$rsha^{commit}" 2>/dev/null; then base=$rsha; fi
  fi
  base=${PREPUSH_BASE:-$base}
  [ -n "$base" ] || infra "no base for $rref: run git fetch origin main"
  jobs="$jobs $lsha:$base"
done

