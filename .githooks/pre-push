  w_gd=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
  w_main=$(git -C "$root" rev-parse -q --verify "refs/remotes/$remote/main^{commit}" 2>/dev/null ||
           git -C "$root" rev-parse -q --verify "refs/remotes/origin/main^{commit}" 2>/dev/null)
  w_key=$key w_dir=$PREPUSH_CACHE/warm/$key
}
warm_start() { # lib-packages vet-packages
  [ -n "$w_dir" ] || { note "cache warm not started (needs setsid, flock and a writable $PREPUSH_CACHE)"; return 0; }
  setsid nice -n 19 bash -c "$WARM_SH" warm "$w_gd" "$w_dir" "$head" "${w_main:-}" "$PREPUSH_CACHE/warm.lock" \
    "$1" "$2" "${CAMP_PREPUSH_LOG_DIR:-}" "$w_key" </dev/null >>"$w_dir/warm.log" 2>&1 &
  note "started a background cache warm (nice 19, one at a time camp-wide; queues behind a running one) of this tree's packages and main ${w_main:0:12}; log: $w_dir/warm.log"
}

# Killed by the dispatcher's budget during tier 1: warm this tree for the next
# push (the trap in 10-common.sh calls on_term).
warm_args=()
on_term() { [ ${#warm_args[@]} -eq 2 ] && warm_start "${warm_args[@]}"; }
# go_checks = go_tier1 + go_tier2; a repo can run its own steps in between
# (smore-agents runs its contract tools there). They share these globals.
go_checks() { go_tier1; go_tier2; }
go_ready="" pkgs="" graph="" live="" users="" gofiles="" t2="none"
go_tier1() {
  local gofiles_all modfiles out rc changed lib n
  go_ready=""
  gofiles=$(only '\.go$' "$GO_EXCLUDE")
  modfiles=$(printf '%s\n' "$files" | grep -E '^go\.(mod|sum)$')
  gofiles_all=$(printf '%s\n' "$files" | grep -E '\.go$' | grep -vE "$GO_EXCLUDE")
  [ -n "$gofiles_all$modfiles" ] || return 0
  go_env
  local max_stale=${PREPUSH_MAX_STALE:-15}

  fmt_bad="" fmt_old=0
  if [ -n "$gofiles" ]; then
    gofmt_new
    [ -z "$fmt_bad" ] || fail "newly unformatted Go files (run gofmt -w on them):\n$fmt_bad"
  fi
  if [ -n "$modfiles" ]; then
    out=$(go list -e -deps -test -f '{{with .Error}}{{.}}{{end}}' ./... 2>&1)
    case $out in *"module lookup disabled"*) infra "a new module is not in the local cache: run go mod download" ;; esac
    out=$(printf '%s\n' "$out" | grep -v '^$')
    [ -z "$out" ] || fail "module graph:\n$(printf '%s\n' "$out" | head -20)"
  fi
  mod=$(go list -m 2>/dev/null) || infra "go list -m failed"
  changed=$(printf '%s\n' $gofiles_all | sed -E 's#/[^/]*$##; s#^[^/]*\.go$#.#' | sort -u |
    while read -r d; do [ "$d" = . ] && echo "$mod" || echo "$mod/$d"; done)
  [ -n "$changed" ] || return 0
  # One go list for the import graph and the build-cache state (about 1 s on
  # smore-agents): path|name|stale|deps|imports+test imports.
  pkgs=$(go list -e -deps -f '{{.ImportPath}}|{{.Name}}|{{.Stale}}|{{join .Deps " "}}|{{join .Imports " "}} {{join .TestImports " "}} {{join .XTestImports " "}}' ./... 2>/dev/null) ||
    infra "go list ./... failed"
  graph=$(printf '%s\n' "$pkgs" | awk -F'|' -v m="$mod" '$1 == m || index($1, m "/") == 1 { print $1, $2, $5 }')
  live=$(printf '%s\n' $changed | grep -Fx -f <(printf '%s\n' "$graph" | cut -d' ' -f1))
  users=$(printf '%s\n' "$graph" | awk -v want="$(printf '%s ' $changed)" '
    BEGIN { n = split(want, w, " "); for (i = 1; i <= n; i++) c[w[i]] = 1 }
    { for (i = 3; i <= NF; i++) if ($i in c && !($1 in c)) { print $1; break } }')
  warm_prep
  if [ -n "$live" ]; then
    lib=$(printf '%s\n' "$graph" | awk -v want="$(printf '%s ' $live)" '
      BEGIN { n = split(want, w, " "); for (i = 1; i <= n; i++) c[w[i]] = 1 }
      ($1 in c) && $2 != "main" { print $1 }')
    n=$(stale $live)
    note "go: build+vet $(printf '%s\n' $live | grep -c .) changed packages ($n to compile)"
    warm_args=("$lib" "$(printf '%s ' $live $users)")   # for the TERM trap
    if [ "$n" -gt "$max_stale" ]; then
      warm_start "${warm_args[@]}"
      infra "build cache is cold for this tree ($n packages to compile > $max_stale); left to the check pod"
    fi
    # build and vet compile different variants (pkg vs pkg [pkg.test]): run
    # them side by side, report the build first.
    local bo="" bp=""
    if [ -n "$lib" ]; then bo=$(mktemp) || infra "mktemp"; go build -o /dev/null $lib >"$bo" 2>&1 & bp=$!; fi
    out=$(go vet $live 2>&1); rc=$?
    if [ -n "$bp" ]; then
      wait "$bp"; local brc=$? bout; bout=$(cat "$bo"); rm -f "$bo"
      case $bout in *"module lookup disabled"*) infra "a module is not in the local cache: run go mod download" ;; esac
      [ $brc -eq 0 ] || fail "go build:\n$bout"
    fi
    case $out in *"module lookup disabled"*) infra "a module is not in the local cache: run go mod download" ;; esac
    [ $rc -eq 0 ] || fail "go vet:\n$out"
    warm_args=()
  fi
  go_ready=1
}
go_tier2() {
  local n l out rc max_stale=${PREPUSH_MAX_STALE:-15}
  [ -n "$go_ready" ] || return 0
  t2="none"
  if [ -n "$users" ]; then
    n=$(stale $users); l=$(left)
    if [ "$n" -gt "$max_stale" ]; then
      t2="skipped ($n to recompile > $max_stale; check pod covers them; warm started)"
      warm_start "" "$(printf '%s ' $users)"
    elif [ "$l" -lt 3 ]; then t2="skipped (budget)"
    elif have timeout; then
      note "go: vet $(printf '%s\n' $users | grep -c .) importers ($n to compile, ${l}s left)"
      out=$(timeout $((l - 1)) go vet $users 2>&1); rc=$?
      case $rc in
        0) t2="ok" ;;
        124) t2="timed out (check pod covers them)" ;;
        *) case $out in *"module lookup disabled"*) t2="skipped (module not cached)" ;;
             *) fail "go vet on importers of the changed packages:\n$out" ;; esac ;;
      esac
    else gocheck "go vet on importers" vet $users; t2="ok"
    fi
    t2="$t2, $(printf '%s\n' $users | grep -c .) importers"
  fi
  note "go: gofmt $(printf '%s\n' $gofiles | grep -c .) files ($fmt_old already unformatted at base, not blocking); build+vet $(printf '%s\n' $live | grep -c .) packages; importer vet $t2"
}
# ---- files (src/30-files.sh) ----
# Syntax only, on changed files: JSON/JSONL parse, node --check, sh/bash -n,
# Python ast.parse (no __pycache__ writes), YAML via yq and shellcheck when
# installed. Each is milliseconds per file (measured on whole repos: <0.5 s).
JS_EXCLUDE=${JS_EXCLUDE:-'(^|/)node_modules/|\.jsx$'}
SHELLCHECK_ONLY=${SHELLCHECK_ONLY:-'.'}   # ERE: which changed scripts get shellcheck
file_checks() {
  local f bad js sh py yml json jsonl out rc
  json=$(only '\.json$' '(^|/)node_modules/')
  jsonl=$(only '\.jsonl$')
  if [ -n "$json$jsonl" ]; then
    have node || infra "node is not on PATH"
    bad=$(printf '%s\n' $json | node -e '
      const fs = require("fs"); const bad = [];
      for (const f of fs.readFileSync(0, "utf8").split("\n").filter(Boolean))
        try { JSON.parse(fs.readFileSync(f, "utf8")) } catch (e) { bad.push(f + ": " + e.message) }
      for (const f of process.argv.slice(1))
        fs.readFileSync(f, "utf8").split("\n").forEach((l, i) => { if (l.trim()) try { JSON.parse(l) } catch (e) { bad.push(f + ":" + (i + 1) + ": " + e.message) } });
      if (bad.length) { console.log(bad.slice(0, 20).join("\n")); process.exit(1) }' -- $jsonl) || fail "invalid JSON:\n$bad"
  fi
  js=$(only '\.(mjs|cjs|js)$' "$JS_EXCLUDE")
  if [ -n "$js" ]; then
    have node || infra "node is not on PATH"
    # One node process for all files (node --check costs a node start per
    # file: 20 files took 5.8 s at nice 10 on a loaded camp-1). Same rules as
    # node --check: .mjs and "type": "module" parse as modules, .cjs and other
    # .js as CommonJS, falling back to module syntax detection for .js. Files
    # it rejects are confirmed (and reported) by node --check itself.
    out=$(printf '%s\n' $js | node --experimental-vm-modules --no-warnings -e '
      const vm = require("vm"), fs = require("fs"), path = require("path");
      if (!vm.SourceTextModule) process.exit(3);
      const typeOf = (f) => { for (let d = path.dirname(path.resolve(f)); ; d = path.dirname(d)) {
        const p = path.join(d, "package.json");
        if (fs.existsSync(p)) { try { return JSON.parse(fs.readFileSync(p, "utf8")).type || "commonjs" } catch { return "commonjs" } }
        if (path.dirname(d) === d) return "commonjs"; } };
      const esm = (src, f) => new vm.SourceTextModule(src, { identifier: f });
      const cjs = (src, f) => vm.compileFunction(src, ["exports", "require", "module", "__filename", "__dirname"], { filename: f });
      let bad = 0;
      for (const f of fs.readFileSync(0, "utf8").split("\n").filter(Boolean)) {
        const src = fs.readFileSync(f, "utf8");
        const mod = f.endsWith(".mjs") || (!f.endsWith(".cjs") && typeOf(f) === "module");
        try { (mod ? esm : cjs)(src, f) } catch (e) {
          if (!mod && !f.endsWith(".cjs")) { try { esm(src, f); continue } catch {} }
          bad++; console.log(f); if (bad >= 10) break;
        }
      }
      process.exit(bad ? 1 : 0)' 2>&1); rc=$?
    case $rc in
      0) ;;
      3) for f in $js; do out=$(node --check "$f" 2>&1) || fail "node --check $f:\n$(printf '%s\n' "$out" | head -8)"; done ;;
      1) for f in $out; do bad=$(node --check "$f" 2>&1) || fail "node --check $f:\n$(printf '%s\n' "$bad" | head -8)"; done ;;
      *) fail "JavaScript syntax check failed:\n$out" ;;
    esac
  fi
  sh=$(printf '%s\n' "$files" | while read -r f; do
    [ -f "$f" ] || continue
    case $f in *.sh|*.bash) echo "$f" ;; *.*) ;; *) head -n1 "$f" 2>/dev/null | grep -qE '^#!.*[/ ](ba|da)?sh( |$)' && echo "$f" ;; esac
  done)
  for f in $sh; do
    if head -n1 "$f" | grep -q bash || case $f in *.bash) true ;; *) false ;; esac; then out=$(bash -n "$f" 2>&1); else out=$(sh -n "$f" 2>&1); fi \
      || fail "shell syntax $f:\n$out"
  done
  if [ -n "$sh" ] && have shellcheck; then
    local sc; sc=$(printf '%s\n' $sh | grep -E "$SHELLCHECK_ONLY")
    [ -z "$sc" ] || { out=$(shellcheck $sc 2>&1) || fail "shellcheck:\n$(printf '%s\n' "$out" | head -40)"; }
  fi
  py=$(printf '%s\n' "$files" | while read -r f; do
    [ -f "$f" ] || continue
    case $f in *.py) echo "$f" ;; *.*) ;; *) head -n1 "$f" 2>/dev/null | grep -q '^#!.*python' && echo "$f" ;; esac
  done)
  if [ -n "$py" ]; then
    have python3 || infra "python3 is not on PATH"
    out=$(python3 -I -c 'import ast, sys
bad = 0
for f in sys.argv[1:]:
    try: ast.parse(open(f, "rb").read(), f)
    except SyntaxError as e: bad += 1; print(f"{f}:{e.lineno}: {e.msg}")
sys.exit(1 if bad else 0)' $py 2>&1) || fail "python syntax:\n$out"
  fi
  yml=$(only '\.ya?ml$')
  if [ -n "$yml" ] && have yq; then
    for f in $yml; do out=$(yq '.' "$f" 2>&1 >/dev/null) || fail "YAML $f:\n$out"; done
  fi
  note "files: json $(printf '%s\n' $json $jsonl | grep -c .), js $(printf '%s\n' $js | grep -c .), shell $(printf '%s\n' $sh | grep -c .), python $(printf '%s\n' $py | grep -c .), yaml $(printf '%s\n' $yml | grep -c .)$(have yq || echo ' (yq not installed: skipped)')"
}
# ---- repo checks (repos/x-go.sh) ----
checks() { go_checks; file_checks; }
# ---- main (src/90-main.sh) ----
for job in $(printf '%s\n' $jobs | sort -u); do
  head=${job%%:*} base=${job##*:}
  files=$(git diff --name-only --no-renames --diff-filter=d "$base" "$head" --)
  deleted=$(git diff --name-only --no-renames --diff-filter=D "$base" "$head" --)
  [ -n "$files$deleted" ] || continue
  files=$(printf '%s\n%s\n' "$files" "$deleted" | grep -v '^$')
  enter_tree "$head"
  checks; rc=$?
  [ $rc -eq 0 ] || exit $rc
  cd "$root" || exit 75
done
exit 0
