w_dir=""
warm_prep() { # once per job, before tier 1, so a TERM only has to fork
  local key
  w_dir="" w_gd="" w_main=""
  have setsid && have flock || return 0
  key=$(printf '%s' "$mod" | tr -c 'A-Za-z0-9._-' '_')
